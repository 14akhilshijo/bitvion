# Bitvion Technologies — Environment Variables
# Copy to .env.local and fill in values. Never commit .env.local.

# Server
PORT=3001
NODE_ENV=development
ALLOWED_ORIGIN=http://localhost:5173

# Email routing (recipient addresses)
EMAIL_INFO=info@bitvion.in
EMAIL_BUSINESS=business@bitvion.in
EMAIL_SALES=sales@bitvion.in
EMAIL_PROJECT=project@bitvion.in
EMAIL_SUPPORT=support@bitvion.in
EMAIL_HR=hr@bitvion.in
EMAIL_FROM=Bitvion Technologies <info@bitvion.in>

# SMTP (optional). If empty, website forms still email Bitvion inboxes
# via FormSubmit (first submission sends a confirmation to that inbox).
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=

# Analytics (loaded only after cookie consent)
VITE_GA_MEASUREMENT_ID=

# Search Console / verification (optional)
VITE_GOOGLE_SITE_VERIFICATION=
VITE_BING_SITE_VERIFICATION=
